# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lightning / LND
LND_RPC_SERVER=localhost:10001
LND_CERT_PATH=/absolute/path/to/tls.cert
LND_MACAROON_PATH=/absolute/path/to/admin.macaroon

# Bitcoin Core / regtest
NETWORK=regtest
RPC_HOST=127.0.0.1
RPC_PORT=18443
RPC_USER=polaruser
RPC_PASSWORD=polarpass
RPC_WALLET=polarwallet

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FX / ETB pricing
COINBASE_EXCHANGE_RATE_URL=https://api.coinbase.com/v2/exchange-rates?currency=BTC
MANUAL_ETB_PER_BTC=
FX_CACHE_TTL_SECONDS=300
